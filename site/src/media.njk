---
layout: base.njk
title: Media
permalink: /media/
---
<section class="page-head stripes"><div class="wrap">
  <span class="eyebrow">Media</span>
  <h1 class="title">Media</h1>
  <p class="lede">{{ media.lede }}</p>
</div></section>

<section class="band"><div class="wrap stack" style="gap:28px">
  <h2 class="h">Videos</h2>
  <div class="videos">
    {%- for v in media.videos %}
    {%- set id = v.url | ytid %}
    <a data-yt="{{ id }}" class="video{% if loop.first %} wide{% endif %}" href="https://www.youtube.com/watch?v={{ id }}"><img src="https://i.ytimg.com/vi/{{ id }}/maxresdefault.jpg" onerror="this.onerror=null;this.src='https://i.ytimg.com/vi/{{ id }}/hqdefault.jpg'" alt="" loading="lazy"><span class="play" aria-hidden="true"></span><span class="ov"><b>{{ v.title }}</b>{% if v.subtitle %}<small>{{ v.subtitle }}</small>{% endif %}</span></a>
    {%- endfor %}
    <a class="video" href="{{ settings.youtube }}"><img src="/img/neverchange.jpg" alt=""><span class="ov"><b>YouTube</b><small>{{ settings.youtube | replace("https://www.", "") }}</small></span></a>
  </div>

  <h2 class="h" style="margin-top:12px">Photos</h2>
  <div class="gallery">
    {%- for ph in media.photos %}
    <figure><div class="framed"><img class="photo" src="{{ ph.image }}" alt="{{ ph.alt }}" loading="lazy"></div>{% if ph.caption %}<figcaption>{{ ph.caption }}</figcaption>{% endif %}</figure>
    {%- endfor %}
  </div>
</div></section>
